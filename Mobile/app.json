{
  "expo": {
    "name": "Pharma Cluster",
    "slug": "Mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/pharma-cluster-icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "pharmacy-cluster.vercel.app",
              "pathPrefix": "/staff-signup/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "adaptiveIcon": {
        "backgroundColor": "#F4F8F5",
        "foregroundImage": "./assets/images/pharma-cluster-adaptive-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.Mobile",
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow the app to scan medicine labels for New Sale.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow the app to select a profile photo.",
          "cameraPermission": "Allow the app to scan medicine labels for New Sale.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4b69a037-4256-4dff-8d74-af2eadfd0b6c"
      }
    }
  }
}
